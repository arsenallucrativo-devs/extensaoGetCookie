{
  "manifest_version": 3,
  "name": "AI Platform PoC — JSON Demo",
  "version": "1.4.0",
  "description": "Extrator de cookies e sessões de IA com suporte universal dinâmico e estratégias dedicadas.",
  "permissions": [
    "clipboardWrite",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "gemini.js",
      "vyral.js",
      "leonardo.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extensao-get-cookie@arsenal.local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "json-builder.js",
        "modal.js",
        "gemini.js",
        "vyral.js",
        "leonardo.js",
        "universal-capture.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
